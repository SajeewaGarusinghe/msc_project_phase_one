# Force LF on everything that a Linux shell or container will execute.
# Without this, git on Windows can check out CRLF and every script fails with
# "bad interpreter: /bin/bash^M" -- a confusing error for an obvious cause.
* text=auto eol=lf

*.sh      text eol=lf
*.py      text eol=lf
Makefile  text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.tf      text eol=lf
*.tftpl   text eol=lf

# PowerShell is the exception -- it is run by Windows.
*.ps1     text eol=crlf

*.png binary
*.pdf binary
