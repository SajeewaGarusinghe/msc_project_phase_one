# ---------------------------------------------------------------------------
# Terraform
# ---------------------------------------------------------------------------
# State contains the public IP, instance IDs and anything marked sensitive.
# It is never committed, even for a single-user research bench.
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform/
.terraform.lock.hcl.bak
crash.log
crash.*.log

# Contains YOUR public IP and SSH key -- the whole reason allowed_cidr exists.
terraform.tfvars
*.auto.tfvars
!terraform.tfvars.example

# Plan files can contain secrets in plaintext.
*.tfplan
*.tfplan.*

# ---------------------------------------------------------------------------
# Cluster credentials
# ---------------------------------------------------------------------------
kubeconfig
kubeconfig.yaml
.kube/
*.kubeconfig

# ---------------------------------------------------------------------------
# Resolved chart versions (generated by scripts/pin-versions.sh on first run).
# The generated file SHOULD be committed once you are happy with it -- it is
# listed here only so an accidental half-written run is not committed.
# Delete this line after your first successful pin.
# ---------------------------------------------------------------------------
platform/versions.lock.env.tmp

# ---------------------------------------------------------------------------
# Local scratch
# ---------------------------------------------------------------------------
.env
.env.local
*.log
tmp/
out/
snapshots/
.DS_Store
