# ---------------------------------------------------------------------------
# Helm chart versions.
#
# These are INTENTIONALLY EMPTY on first checkout. Empty means "whatever Helm
# resolves as latest", which is correct for a first install and wrong for a
# reproducible experiment.
#
# PINNED from a verified install on 2026-10-29 (make pin-versions).
#
# Re-run `make pin-versions` after any deliberate upgrade and commit the diff,
# so a chart change is always a reviewable commit rather than something that
# happens silently between two capture runs.
#
# This matters more than usual here: a chart bump that changes a metric name or
# a resource attribute would invalidate comparisons between snapshots captured
# before and after it.
# ---------------------------------------------------------------------------

CHART_VERSION_OTEL_DEMO="0.42.6"
CHART_VERSION_OTEL_COLLECTOR="0.178.0"
CHART_VERSION_PROMETHEUS="29.39.0"
CHART_VERSION_TEMPO="1.24.4"
CHART_VERSION_LOKI="7.5.0"
CHART_VERSION_GRAFANA="10.5.15"
CHART_VERSION_CHAOS_MESH="2.8.7"

# Helm repositories. Changing these is a supply-chain decision -- review it.
REPO_OTEL="https://open-telemetry.github.io/opentelemetry-helm-charts"
REPO_PROMETHEUS="https://prometheus-community.github.io/helm-charts"
REPO_GRAFANA="https://grafana.github.io/helm-charts"
REPO_CHAOS_MESH="https://charts.chaos-mesh.org"
